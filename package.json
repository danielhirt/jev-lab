{
  "name": "jev-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "lab": "bun run --cwd packages/lab lab",
    "codenames": "bun run --cwd packages/codenames cli",
    "wavelength": "bun run --cwd packages/wavelength cli",
    "typecheck": "bun run --cwd packages/lab typecheck && bun run --cwd packages/codenames typecheck && bun run --cwd packages/wavelength typecheck",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  }
}
